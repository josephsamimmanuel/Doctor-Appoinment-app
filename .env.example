# Application
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database — MongoDB connection string (Mongoose)
# Local default: mongodb://localhost:27017/doctor-appointment
MONGODB_URI=mongodb://localhost:27017/doctor-appointment

# Cache — Redis connection URL (ioredis)
# Local default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Copy this file to .env at the repo root and adjust values for local development.
# The server loads repo-root .env first, then apps/server/.env (server overrides root).
